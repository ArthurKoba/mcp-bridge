# Briareus-only operator contract. No legacy MCP environment or compatibility aliases.
# Secret VALUES belong exclusively to protected Coolify Project Shared Variables.
# Application environment entries are REFERENCES to those project-level secrets,
# not copies of plaintext. Never grant application operators resolved-env access.
#
# Data owner: required secret, must remain blank until operator provisions it.
POSTGRES_PASSWORD=
#
# Data topology defaults owned by Compose / DB-only source settings:
# POSTGRES_HOST=briareus-postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=briareus_identity  # example owner; D4 binds service-specific DB
# POSTGRES_USER=<D4-owned-per-database-role>
#
# Admin API / authorization identity: required signing secret when loaded.
ADMIN_JWT_SIGNING_KEY=
#
# Credential storage + domain-separated protected idempotency replay:
# required Fernet key (32 random bytes, URL-safe base64); not a JWT signing key.
CREDENTIAL_ENCRYPTION_KEY=
#
# Identity-only, needed only when the API generates invitation/reset links.
# ADMIN_UI_PUBLIC_URL=https://admin.example.com
#
# Authorization signing service ONLY when its signed-transport entrypoint
# is deployed and trusted. Required Ed25519 PEM private key, supplied through
# a protected Project Shared Variable. No SERVICE_IDENTITY_ENABLED switch.
# DELEGATION_SIGNING_PRIVATE_KEY=
#
# Valkey secret (VALKEY_PASSWORD) belongs to the data deployment, not this
# Backend process. Stable internal addresses/timeouts are not operator ENV.
