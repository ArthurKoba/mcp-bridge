  "layout": "deploy/<module>",
  "management": {
    "bootstrap": "deploy/bootstrap_coolify.py",
    "watch_sync": "deploy/sync_watch_paths_coolify.py",
    "static_verify": "deploy/verify_deploy_static.py",
    "network": "briareus-net",
    "auto_deploy_during_bootstrap": false,
    "deploy_during_bootstrap": false,
    "build_strategy": "coolify_git_webhook_uv_cached_deps_noneditable_project"
  },
  "configuration_contract": {
    "team_shared": [
      "TZ",
      "OTLP_ENDPOINT",
      "OTLP_BEARER_TOKEN"
    ],
    "environment_shared": [
      "SERVICE_NAMESPACE",
      "DEPLOYMENT_ENVIRONMENT",
      "POSTGRES_USER",
      "POSTGRES_PASSWORD",
      "VALKEY_PASSWORD",
      "IDENTITY_POSTGRES_USER",
      "IDENTITY_POSTGRES_PASSWORD",
      "ACCESS_POSTGRES_USER",
      "ACCESS_POSTGRES_PASSWORD",
      "CONTROL_POSTGRES_USER",
      "CONTROL_POSTGRES_PASSWORD",
      "CATALOG_POSTGRES_USER",
      "CATALOG_POSTGRES_PASSWORD",
      "IDENTITY_MIGRATION_POSTGRES_USER",
