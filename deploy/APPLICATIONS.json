      "OTLP_BEARER_TOKEN",
      "POSTGRES_PASSWORD",
      "VALKEY_PASSWORD",
      "IDENTITY_POSTGRES_PASSWORD",
      "ACCESS_POSTGRES_PASSWORD",
      "CONTROL_POSTGRES_PASSWORD",
      "CATALOG_POSTGRES_PASSWORD",
      "IDENTITY_MIGRATION_POSTGRES_PASSWORD",
      "ACCESS_MIGRATION_POSTGRES_PASSWORD",
      "CONTROL_MIGRATION_POSTGRES_PASSWORD",
      "CATALOG_MIGRATION_POSTGRES_PASSWORD"
    ],
    "read_secret_values": false,
    "safe_defaults": {
      "POSTGRES_DB": "briareus_dev",
      "POSTGRES_PORT": "5432",
      "TZ": "UTC",
      "SERVICE_NAMESPACE": "briareus",
      "DEPLOYMENT_ENVIRONMENT": "development"
