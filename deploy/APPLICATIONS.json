  "server": "tambov",
  "coolify_project": "briareus",
  "environment": "development",
  "network_destination": "briareus-net",
  "repository": "ArthurKoba/briareus",
  "branch": "TO_BE_SET_TO_REVIEWED_PUBLISHED_DEV_REF",
